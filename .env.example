# Runtime / AI
GEMINI_API_KEY=""
APP_URL="https://host.velclaw.app"

# VelclawHost Control Plane
VELCLAWHOST_API_TOKEN=""
PORT="3000"

# Durable queue/control-plane state
VELCLAWHOST_STATE_STORE="postgres"
DATABASE_URL=""
VELCLAWHOST_WORKER_ID="control-plane-1"
DEPLOYMENT_QUEUE_INTERVAL_MS="5000"
DEPLOYMENT_EXECUTOR="docker"

# Runtime / image settings
IMAGE_REGISTRY=""
IMAGE_PUSH="false"
RUNTIME_PROVIDER="docker"
RUNTIME_IMAGE=""
RUNTIME_CONTAINER_PORT="3000"
RUNTIME_PORT_START="4100"

# Caddy / ingress
CADDY_CONFIG_DIR="./deploy/generated"
CADDY_UPSTREAM_HOST="host.docker.internal"
CADDY_AUTO_RELOAD="true"
CADDY_ADMIN_URL="http://127.0.0.1:2019"

# Docker Compose control-plane
POSTGRES_PASSWORD=""


# Domain / registrar control plane
# Target registrar/reseller used for new registrations and inbound transfers.
# Safe default: sandbox/test mode until production credentials are explicitly supplied.
VELCLAWHOST_REGISTRAR="resellerclub"
VELCLAWHOST_SOURCE_REGISTRAR="vercel"

# ResellerClub target registrar/reseller
RESELLERCLUB_TEST_MODE="true"
RESELLERCLUB_USER_ID=""
RESELLERCLUB_API_KEY=""
RESELLERCLUB_TEST_API_BASE_URL="https://test.httpapi.com/api"
RESELLERCLUB_API_BASE_URL="https://httpapi.com/api"
RESELLERCLUB_CUSTOMER_ID=""
RESELLERCLUB_REG_CONTACT_ID=""
RESELLERCLUB_ADMIN_CONTACT_ID=""
RESELLERCLUB_TECH_CONTACT_ID=""
RESELLERCLUB_BILLING_CONTACT_ID=""
RESELLERCLUB_CURRENCY="USD"

# Vercel source registrar / migration
VERCEL_REGISTRAR_TOKEN=""
VERCEL_REGISTRAR_TEAM_ID=""
VERCEL_REGISTRAR_API_BASE_URL="https://api.vercel.com"
