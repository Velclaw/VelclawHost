# Runtime / AI
GEMINI_API_KEY=""
APP_URL="http://localhost:3000"

# VelclawHost Control Plane
VELCLAWHOST_API_TOKEN=""
PORT="3000"

# Durable queue/control-plane state
VELCLAWHOST_STATE_STORE="file"
DATABASE_URL=""
VELCLAWHOST_WORKER_ID="local"
DEPLOYMENT_QUEUE_INTERVAL_MS="10000"
DEPLOYMENT_EXECUTOR="none"

# Runtime / image settings
IMAGE_REGISTRY=""
IMAGE_PUSH="false"
RUNTIME_PROVIDER="docker"
RUNTIME_IMAGE=""
RUNTIME_CONTAINER_PORT="3000"
RUNTIME_PORT_START="4100"

# Caddy / ingress
CADDY_CONFIG_DIR="./deploy/generated"
CADDY_UPSTREAM_HOST="host.docker.internal"
CADDY_AUTO_RELOAD="false"
CADDY_ADMIN_URL="http://127.0.0.1:2019"

# Docker Compose control-plane
POSTGRES_PASSWORD=""
